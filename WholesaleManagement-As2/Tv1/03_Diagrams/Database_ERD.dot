digraph WholesaleERD {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.7", ranksep="1.2", splines=polyline, fontname="Arial", label="WHOLESALE MANAGEMENT  |  DATABASE ENTITY RELATIONSHIP DIAGRAM", labelloc=t, fontsize=20, fontcolor="#152f4d"];
    node [shape=plain, fontname="Arial"];
    edge [color="#3e7198", penwidth=1.8, arrowsize=0.7, fontname="Arial", fontsize=10];
    Item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7ca8c7" BGCOLOR="white"><TR><TD BGCOLOR="#173a60" COLSPAN="2"><FONT COLOR="white"><B>Item</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">ItemID : int</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ItemName : nvarchar(120)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Size : nvarchar(40)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Price : decimal(18,2)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">StockQuantity : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">RowVersion : rowversion</TD></TR></TABLE>>];
    Agent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7ca8c7" BGCOLOR="white"><TR><TD BGCOLOR="#173a60" COLSPAN="2"><FONT COLOR="white"><B>Agent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">AgentID : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">AgentName : nvarchar(120)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Address : nvarchar(250)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Phone : nvarchar(20)</TD></TR></TABLE>>];
    Users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7ca8c7" BGCOLOR="white"><TR><TD BGCOLOR="#173a60" COLSPAN="2"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">UserID : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">UserName : nvarchar(80), UNIQUE</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Email : nvarchar(160), UNIQUE</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Password : nvarchar(255), PBKDF2</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Lock : bit</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Role : Admin / Agent</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">AgentID : int, nullable, UNIQUE</TD></TR><TR><TD></TD><TD ALIGN="LEFT">FailedLoginCount : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">LastLoginAtUtc : datetime2</TD></TR></TABLE>>];
    Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7ca8c7" BGCOLOR="white"><TR><TD BGCOLOR="#173a60" COLSPAN="2"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">OrderID : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">OrderDate : datetime2 UTC</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">AgentID : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">OrderStatus : Pending / Shipped</TD></TR></TABLE>>];
    Detail [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7ca8c7" BGCOLOR="white"><TR><TD BGCOLOR="#173a60" COLSPAN="2"><FONT COLOR="white"><B>OrderDetail</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">ID : int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">OrderID : int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">ItemID : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">Quantity : int</TD></TR><TR><TD></TD><TD ALIGN="LEFT">UnitAmount : decimal(18,2)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">UNIQUE(OrderID, ItemID)</TD></TR></TABLE>>];
    Agent -> Order [label="1 : many  |  NO ACTION"];
    Agent -> Users [label="1 : 0..1  |  NO ACTION",color="#397e6b"];
    Order -> Detail [label="1 : many  |  NO ACTION"];
    Item -> Detail [label="1 : many  |  NO ACTION"];
    { rank=same; Agent; Item; }
    { rank=same; Order; Users; }
}
